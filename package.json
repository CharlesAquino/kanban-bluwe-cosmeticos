{
  "name": "kanban-nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:setup": "npx prisma generate && npx prisma db push --force-reset",
    "db:push": "npx drizzle-kit push:pg",
    "db:generate": "npx drizzle-kit generate:pg",
    "db:studio": "npx drizzle-kit studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "npm run db:push",
    "clean": "rm -rf .next && rm -rf node_modules/.prisma && npm install",
    "clean:windows": "if exist .next rmdir /s /q .next && if exist node_modules\\.prisma rmdir /s /q node_modules\\.prisma && npm install",
    "reset": "npm run clean:windows && npx prisma generate --force-reset",
    "deploy:vercel": "vercel --prod",
    "migrate:postgres": "node scripts/migrate-to-postgres.js",
    "deploy:docker": "docker build -t kanban-bluwe-cosmeticos . && docker run -p 3000:3000 kanban-bluwe-cosmeticos",
    "docker:build": "docker build -t kanban-bluwe-cosmeticos .",
    "docker:run": "docker run -p 3000:3000 kanban-bluwe-cosmeticos",
    "deploy:github": "npm run build:prod && gh-pages -d out",
    "build:prod": "ren next.config.js next.config.dev.js && ren next.config.prod.js next.config.js && npm run build && ren next.config.js next.config.prod.js && ren next.config.dev.js next.config.js",
    "mcp:install": "npm install @modelcontextprotocol/sdk",
    "mcp:setup": "npm run mcp:install && echo 'MCP SDK installed successfully'"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@prisma/client": "^6.17.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.15.6",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.20.14",
    "drizzle-orm": "^0.30.10",
    "glob": "^11.0.3",
    "lucide-react": "^0.545.0",
    "next": "^15.3.0",
    "next-auth": "^4.24.13",
    "node-fetch": "^2.7.0",
    "pg": "^8.16.3",
    "playwright": "^1.57.0",
    "prisma": "^6.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-qr-code": "^2.0.18",
    "redis": "^4.6.12",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "gh-pages": "^6.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.9"
  },
  "description": "Sistema Kanban de Produção completo com Next.js 15, SQLite, Prisma ORM e servidores MCP. Projeto refatorado com estrutura organizada em pastas: docs, scripts, tests, mcp-servers.",
  "main": "next.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
