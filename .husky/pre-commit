#!/bin/sh
# Husky pre-commit hook
# Executa verificações de segurança e testes antes de cada commit

echo "🔒 Executando verificações de segurança..."

# Security check
if [ -f "scripts/pre-commit-security.sh" ]; then
  bash scripts/pre-commit-security.sh
  if [ $? -ne 0 ]; then
    echo "❌ Verificação de segurança falhou. Commit bloqueado."
    exit 1
  fi
fi

echo "🧪 Executando testes pré-commit..."

# Windows vs Unix
if [ -f "scripts/pre-commit-test.ps1" ]; then
  pwsh -Command "& './scripts/pre-commit-test.ps1'"
else
  bash scripts/pre-commit-test.sh
fi

if [ $? -ne 0 ]; then
  echo "❌ Testes falharam. Commit bloqueado."
  exit 1
fi

echo "✅ Todas as verificações passaram. Commit permitido."
